# All optional for local development; the demo runs without them.

# Procurement assistant via Amazon Bedrock. Unset = rule-based answers (labelled in the UI).
# Use a model or inference profile ID enabled in your account, e.g. an Anthropic Claude model on Bedrock.
BEDROCK_MODEL_ID=
AWS_REGION=us-east-1

# HubSpot private app token for demo requests. Unset = saved to .data/demo-requests.jsonl in development.
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_DEMO_PIPELINE_ID=
HUBSPOT_DEMO_STAGE_ID=
